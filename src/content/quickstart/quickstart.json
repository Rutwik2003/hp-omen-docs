{
    "id": "quickstart",
    "title": "Quick Start Guide",
    "description": "Get your OMEN laptop set up and optimized in just a few steps. Follow this guide to ensure you're getting the best performance from day one.",
    "category": "Quick Start",
    "metadata": {
        "difficulty": "Beginner",
        "readTime": "5 min",
        "lastUpdated": "Sep 2024"
    },
    "breadcrumbs": [
        {
            "label": "Quick Start"
        },
        {
            "label": "Initial Setup"
        }
    ],
    "steps": [
        {
            "id": "step-1",
            "title": "Unbox and Initial Setup",
            "content": "",
            "blocks": [
                {
                    "id": "b1",
                    "type": "text",
                    "content": "<p>Get your OMEN laptop ready for first use.</p>"
                },
                {
                    "id": "b2",
                    "type": "list",
                    "content": {
                        "style": "unordered",
                        "items": [
                            "Remove all packaging materials and protective films",
                            "Connect the power adapter and charge to 100%",
                            "Power on and complete Windows setup wizard",
                            "Connect to Wi-Fi network",
                            "Update Windows to latest version"
                        ]
                    }
                },
                {
                    "id": "step1-tip",
                    "type": "callout",
                    "variant": "info",
                    "title": "First Boot Tip",
                    "content": "<p>Keep the laptop plugged in during initial setup. Windows updates and driver installations are resource-intensive and work best on AC power.</p>"
                }
            ]
        },
        {
            "id": "step-2",
            "title": "Essential Software Installation",
            "content": "",
            "blocks": [
                {
                    "id": "b3",
                    "type": "text",
                    "content": "<p>Install critical HP software and drivers.</p>"
                },
                {
                    "id": "b4",
                    "type": "list",
                    "content": {
                        "style": "unordered",
                        "items": [
                            "<strong>HP Support Assistant</strong> - For BIOS and driver updates",
                            "<strong>OMEN Gaming Hub</strong> - From Microsoft Store for performance control",
                            "Update all drivers through HP Support Assistant",
                            "<strong>NVIDIA App</strong> or AMD Radeon Software for GPU drivers",
                            "Configure Windows Update settings"
                        ]
                    }
                },
                {
                    "id": "step2-warning",
                    "type": "callout",
                    "variant": "warning",
                    "title": "Driver Order Matters",
                    "content": "<p>Install chipset drivers first, then GPU drivers. Always restart when prompted. This ensures proper hardware initialization.</p>"
                }
            ]
        },
        {
            "id": "step-3",
            "title": "Performance Configuration",
            "content": "",
            "blocks": [
                {
                    "id": "b5",
                    "type": "text",
                    "content": "<p>Optimize your system for gaming and productivity.</p>"
                },
                {
                    "id": "b6",
                    "type": "list",
                    "content": {
                        "style": "unordered",
                        "items": [
                            "<strong>OGH Performance Mode</strong> - Use for gaming; Comfort for battery life",
                            "Set up thermal profiles for different use cases",
                            "Configure RGB lighting preferences",
                            "<strong>Display settings</strong> - Enable highest refresh rate (144Hz/165Hz)",
                            "Enable XMP/DOCP in BIOS for full RAM speed (if supported)"
                        ]
                    }
                },
                {
                    "id": "step3-tip",
                    "type": "callout",
                    "variant": "success",
                    "title": "Quick Access",
                    "content": "<p>Press the <strong>OMEN Key</strong> (above keyboard) to instantly open OMEN Gaming Hub and switch performance modes.</p>"
                }
            ]
        },
        {
            "id": "step-4",
            "title": "Gaming Setup",
            "content": "",
            "blocks": [
                {
                    "id": "b7",
                    "type": "text",
                    "content": "<p>Configure your laptop for optimal gaming experience.</p>"
                },
                {
                    "id": "b8",
                    "type": "list",
                    "content": {
                        "style": "unordered",
                        "items": [
                            "Install <strong>Steam</strong>, Epic Games, or preferred game launchers",
                            "Configure <strong>NVIDIA Control Panel</strong> for optimal performance",
                            "Enable <strong>Game Mode</strong> in Windows Settings → Gaming",
                            "Configure audio settings and spatial sound",
                            "Test performance with benchmark tools (3DMark, UserBenchmark)"
                        ]
                    }
                },
                {
                    "id": "step4-tip",
                    "type": "callout",
                    "variant": "info",
                    "title": "First Game Test",
                    "content": "<p>Run a demanding game for 15-20 minutes while monitoring temperatures with HWiNFO64 or MSI Afterburner. This helps identify any thermal issues early.</p>"
                }
            ]
        },
        {
            "id": "step-5",
            "title": "Essential Downloads",
            "content": "",
            "blocks": [
                {
                    "id": "b9",
                    "type": "grid",
                    "columns": 2,
                    "children": [
                        {
                            "id": "g1-c1",
                            "type": "column",
                            "children": [
                                {
                                    "id": "b10",
                                    "type": "callout",
                                    "variant": "info",
                                    "title": "HP Support Assistant",
                                    "content": "<p>Automatic driver updates and system diagnostics.</p><a href='https://support.hp.com/us-en/help/hp-support-assistant'>Download</a>"
                                },
                                {
                                    "id": "b11",
                                    "type": "callout",
                                    "variant": "success",
                                    "title": "NVIDIA App",
                                    "content": "<p>Graphics driver updates and game optimization.</p><a href='https://www.nvidia.com/en-us/software/nvidia-app/'>Download</a>"
                                }
                            ]
                        },
                        {
                            "id": "g1-c2",
                            "type": "column",
                            "children": [
                                {
                                    "id": "b12",
                                    "type": "callout",
                                    "variant": "info",
                                    "title": "OMEN Gaming Hub",
                                    "content": "<p>Performance monitoring and system optimization.</p><a href='ms-windows-store://pdp/?productid=9NRDR7P8S58S'>Download</a>"
                                },
                                {
                                    "id": "b13",
                                    "type": "callout",
                                    "variant": "success",
                                    "title": "AMD Radeon Software",
                                    "content": "<p>AMD graphics drivers and optimization tools.</p><a href='https://www.amd.com/en/support'>Download</a>"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "step-6",
            "title": "Important Tips",
            "content": "",
            "blocks": [
                {
                    "id": "b14",
                    "type": "callout",
                    "variant": "warning",
                    "title": "First Boot Tips",
                    "content": "<p>Allow your laptop to fully boot and complete initial Windows setup before installing additional software. This prevents conflicts and ensures smooth operation.</p>"
                },
                {
                    "id": "b15",
                    "type": "callout",
                    "variant": "tip",
                    "title": "BIOS Settings",
                    "content": "<p>Access BIOS by pressing F10 during startup. Enable XMP/DOCP for RAM, set boot priority, and configure thermal settings if needed.</p>"
                },
                {
                    "id": "b16",
                    "type": "callout",
                    "variant": "info",
                    "title": "Thermal Management",
                    "content": "<p>Use OMEN Gaming Hub to create performance profiles. \"Comfort\" for daily use, \"Performance\" for gaming, and \"Cool\" for quiet operation.</p>"
                }
            ]
        }
    ]
}