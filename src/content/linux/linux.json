            "id": "setup",
            "title": "Initial Setup",
            "content": "",
            "blocks": [
                {
                    "id": "b2",
                    "type": "list",
                    "content": {
                        "style": "ordered",
                        "items": [
                            "Disable Secure Boot in BIOS (F10)",
                            "Create bootable USB using Rufus (Windows) or Etcher",
                            "Boot from USB (F9)",
                            "Install OS (Select 'Install third-party software' for drivers)",
                            "Update system: `sudo apt update && sudo apt upgrade`"
                        ]
                    }
                }
            ]
        },
        {
            "id": "drivers",
            "title": "Graphics Drivers",
            "content": "",
            "blocks": [
                {
                    "id": "b3",
                    "type": "heading",
                    "level": 3,
                    "content": "NVIDIA Driver Installation"
                },
                {
                    "id": "b4",
                    "type": "code",
                    "language": "bash",
                    "code": "# Ubuntu/Pop!_OS\nsudo apt install nvidia-driver-535\n\n# Arch/Manjaro\nsudo pacman -S nvidia nvidia-utils"
                },
                {
                    "id": "b5",
                    "type": "callout",
                    "variant": "info",
                    "title": "Hybrid Graphics",
                    "content": "<p>For laptops, you need to manage switching between iGPU and dGPU. We recommend <strong>optimus-manager</strong> (Arch) or using the built-in prime-select tool (Ubuntu).</p>"
                }
            ]
        },
        {
            "id": "gaming",
            "title": "Gaming Setup",
            "content": "",
            "blocks": [
                {
                    "id": "b6",
                    "type": "list",
                    "content": {
                        "style": "unordered",
                        "items": [
                            "Install Steam Native",
                            "Enable Steam Play (Proton) for all titles in Settings",
                            "Install Lutris for non-Steam games (Epic, GOG)",
                            "Install GameMode: `sudo apt install gamemode`"
                        ]
                    }
                }
            ]
