        }
    ],
    "steps": [
        {
            "id": "distros",
            "title": "Recommended Distributions",
            "content": "",
            "blocks": [
                {
                    "id": "distros-intro",
                    "type": "text",
                    "content": "<p>Choosing the right Linux distribution is crucial for OMEN laptop compatibility. These distros have been tested and work well with NVIDIA Optimus/hybrid graphics.</p>"
                },
                {
                    "id": "b1",
                    "type": "grid",
                    "columns": 2,
                    "children": [
                        {
                            "id": "c1",
                            "type": "column",
                            "children": [
                                {
                                    "id": "t1",
                                    "type": "heading",
                                    "level": 3,
                                    "content": "Pop!_OS (Recommended)"
                                },
                                {
                                    "id": "p1",
                                    "type": "text",
                                    "content": "<p>Gaming-focused with pre-installed NVIDIA drivers. Best out-of-box experience for OMEN laptops. Download the <strong>NVIDIA ISO</strong>.</p>"
                                }
                            ]
                        },
                        {
                            "id": "c2",
                            "type": "column",
                            "children": [
                                {
                                    "id": "t2",
                                    "type": "heading",
                                    "level": 3,
                                    "content": "Ubuntu 24.04 LTS"
                                },
                                {
                                    "id": "p2",
                                    "type": "text",
                                    "content": "<p>Most popular and stable. Huge community support means solutions for most issues are just a search away.</p>"
                                }
                            ]
                        },
                        {
                            "id": "c3",
                            "type": "column",
                            "children": [
                                {
                                    "id": "t3",
                                    "type": "heading",
                                    "level": 3,
                                    "content": "Manjaro / Arch"
                                },
                                {
                                    "id": "p3",
                                    "type": "text",
                                    "content": "<p>For advanced users. Rolling release means latest kernels and drivers. AUR has everything you need.</p>"
                                }
                            ]
                        },
                        {
                            "id": "c4",
                            "type": "column",
                            "children": [
                                {
                                    "id": "t4",
                                    "type": "heading",
                                    "level": 3,
                                    "content": "Fedora"
                                },
                                {
                                    "id": "p4",
                                    "type": "text",
                                    "content": "<p>Cutting-edge features with excellent Wayland support. Pure GNOME experience, backed by Red Hat.</p>"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "distros-tip",
                    "type": "callout",
                    "variant": "success",
                    "title": "First Timer?",
                    "content": "<p>Start with <strong>Pop!_OS</strong> or <strong>Ubuntu</strong>. They have the easiest setup and best driver support. You can always switch later once you're comfortable with Linux.</p>"
                }
            ]
        },
        {
            "id": "setup",
            "title": "Initial Setup",
            "content": "",
            "blocks": [
                {
                    "id": "setup-intro",
                    "type": "text",
                    "content": "<p>Follow these steps to install Linux on your OMEN laptop. We recommend dual-booting to keep Windows available for games with anti-cheat.</p>"
                },
                {
                    "id": "setup-warning",
                    "type": "callout",
                    "variant": "warning",
                    "title": "Backup First",
                    "content": "<p>Always backup important data before installing a new OS. Partitioning mistakes can result in data loss.</p>"
                },
                {
                    "id": "setup-steps-h",
                    "type": "heading",
                    "level": 3,
                    "content": "Installation Steps"
                },
                {
                    "id": "b2",
                    "type": "list",
                    "content": {
                        "style": "ordered",
                        "items": [
                            "<strong>Disable Secure Boot:</strong> Enter BIOS (F10 at boot) → Security → Disable Secure Boot",
                            "<strong>Create bootable USB:</strong> Use Rufus (Windows) or balenaEtcher to flash the ISO",
                            "<strong>Boot from USB:</strong> Press F9 at boot to select boot device",
                            "<strong>Install OS:</strong> Select 'Install third-party software' for NVIDIA drivers",
                            "<strong>Dual-boot tip:</strong> Shrink Windows partition first using Disk Management"
                        ]
                    }
                },
                {
                    "id": "setup-post",
                    "type": "heading",
                    "level": 3,
                    "content": "Post-Installation"
                },
                {
                    "id": "setup-update",
                    "type": "code",
                    "language": "bash",
                    "code": "# Update your system immediately after install\nsudo apt update && sudo apt upgrade -y\n\n# Install essential tools\nsudo apt install git curl wget htop neofetch"
                },
                {
                    "id": "setup-tip",
                    "type": "callout",
                    "variant": "info",
                    "title": "Kernel Updates",
                    "content": "<p>Newer kernels often have better hardware support for OMEN laptops. On Ubuntu, consider using the HWE (Hardware Enablement) kernel or mainline kernel for latest features.</p>"
                }
            ]
        },
        {
            "id": "drivers",
            "title": "Graphics Drivers",
            "content": "",
            "blocks": [
                {
                    "id": "b3",
                    "type": "heading",
                    "level": 3,
                    "content": "NVIDIA Driver Installation"
                },
                {
                    "id": "b4",
                    "type": "code",
                    "language": "bash",
                    "code": "# Ubuntu/Pop!_OS\nsudo apt install nvidia-driver-535\n\n# Arch/Manjaro\nsudo pacman -S nvidia nvidia-utils"
                },
                {
                    "id": "b5",
                    "type": "callout",
                    "variant": "info",
                    "title": "Hybrid Graphics",
                    "content": "<p>For laptops, you need to manage switching between iGPU and dGPU. We recommend <strong>optimus-manager</strong> (Arch) or using the built-in prime-select tool (Ubuntu).</p>"
                }
            ]
        },
        {
            "id": "gaming",
            "title": "Gaming Setup",
            "content": "",
            "blocks": [
                {
                    "id": "gaming-intro",
                    "type": "text",
                    "content": "<p>Linux gaming has come a long way. With Proton and native ports, most games work great on your OMEN laptop.</p>"
                },
                {
                    "id": "gaming-steam-h",
                    "type": "heading",
                    "level": 3,
                    "content": "Steam & Proton"
                },
                {
                    "id": "gaming-steam-code",
                    "type": "code",
                    "language": "bash",
                    "code": "# Install Steam (Ubuntu/Pop!_OS)\nsudo apt install steam\n\n# Install Steam (Arch/Manjaro)\nsudo pacman -S steam"
                },
                {
                    "id": "gaming-proton",
                    "type": "callout",
                    "variant": "success",
                    "title": "Enable Proton",
                    "content": "<p>In Steam: Settings → Compatibility → Enable Steam Play for all titles → Select Proton Experimental or latest stable version.</p>"
                },
                {
                    "id": "gaming-tools-h",
                    "type": "heading",
                    "level": 3,
                    "content": "Essential Gaming Tools"
                },
                {
                    "id": "gaming-tools-code",
                    "type": "code",
                    "language": "bash",
                    "code": "# GameMode - Optimizes system for gaming\nsudo apt install gamemode\n\n# MangoHud - In-game performance overlay\nsudo apt install mangohud\n\n# Lutris - For non-Steam games (Epic, GOG, etc.)\nsudo apt install lutris"
                },
                {
                    "id": "b6",
                    "type": "list",
                    "content": {
                        "style": "unordered",
                        "items": [
                            "<strong>ProtonDB:</strong> Check game compatibility at <a href='https://www.protondb.com/' target='_blank'>protondb.com</a>",
                            "<strong>Heroic Launcher:</strong> Alternative for Epic Games Store with better Linux support",
                            "<strong>Wine/Bottles:</strong> Run Windows apps that don't work with Proton",
                            "<strong>MangoHud:</strong> Add <code>mangohud %command%</code> to Steam launch options for FPS overlay"
                        ]
                    }
                },
                {
                    "id": "gaming-anticheat",
                    "type": "callout",
                    "variant": "warning",
                    "title": "Anti-Cheat Games",
                    "content": "<p>Some games with anti-cheat (Valorant, FACEIT, some EA titles) don't work on Linux. Check ProtonDB for compatibility. This is why dual-booting Windows is recommended.</p>"
                }
            ]
        },
        {
            "id": "commands",
            "title": "Essential Commands",
            "content": "",
            "blocks": [
                {
                    "id": "commands-intro",
                    "type": "text",
                    "content": "<p>These terminal commands help you monitor system health, troubleshoot issues, and manage your Linux installation on OMEN hardware.</p>"
                },
                {
                    "id": "commands-monitor-h",
                    "type": "heading",
                    "level": 3,
                    "content": "System Monitoring"
                },
                {
                    "id": "b7",
                    "type": "table",
                    "content": {
                        "headers": [
                            "Command",
                            "Description"
                        ],
                        "rows": [
                            [
                                "nvidia-smi",
                                "Check GPU status, usage, temperature, and power draw"
                            ],
                            [
                                "htop",
                                "Interactive process monitor (better than top)"
                            ],
                            [
                                "sensors",
                                "Display CPU, GPU, and chassis temperatures"
                            ],
                            [
                                "lscpu",
                                "Detailed CPU information"
                            ],
                            [
                                "free -h",
                                "Check RAM usage in human-readable format"
                            ],
                            [
                                "df -h",
                                "Check disk space usage"
                            ],
                            [
                                "lspci | grep -i nvidia",
                                "Verify NVIDIA GPU is detected"
                            ]
                        ]
                    }
                },
                {
                    "id": "commands-driver-h",
                    "type": "heading",
                    "level": 3,
                    "content": "Driver & System Management"
                },
                {
                    "id": "commands-driver-table",
                    "type": "table",
                    "content": {
                        "headers": [
                            "Command",
                            "Description"
                        ],
                        "rows": [
                            [
                                "sudo ubuntu-drivers autoinstall",
                                "Auto-install recommended drivers (Ubuntu)"
                            ],
                            [
                                "prime-select query",
                                "Check current GPU mode (NVIDIA/Intel)"
                            ],
                            [
                                "prime-select nvidia",
                                "Switch to NVIDIA GPU"
                            ],
                            [
                                "sudo systemctl restart gdm",
                                "Restart display manager"
                            ]
                        ]
                    }
                },
                {
                    "id": "commands-tip",
                    "type": "callout",
                    "variant": "info",
                    "title": "Install sensors",
                    "content": "<p>If <code>sensors</code> command not found: <code>sudo apt install lm-sensors</code> then run <code>sudo sensors-detect</code> to configure.</p>"
                }
            ]
        }
    ]
}