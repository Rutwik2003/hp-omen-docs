                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "dis-tip",
                    "type": "callout",
                    "variant": "tip",
                    "title": "Find Your Model",
                    "content": "<p>Search for your exact model number (e.g., 'OMEN 15-en0xxx') on HP Support YouTube channel for the most relevant disassembly video.</p>"
                }
            ]
        }
    ]
