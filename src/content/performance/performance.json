    "steps": [
        {
            "id": "power",
            "title": "Power & Thermal Management",
            "content": "",
            "blocks": [
                {
                    "id": "b1",
                    "type": "text",
                    "content": "<p>Optimize power consumption and thermal performance to prevent throttling.</p>"
                },
                {
                    "id": "b2",
                    "type": "callout",
                    "variant": "info",
                    "title": "OMEN Gaming Hub",
                    "content": "<p>Use <strong>Performance</strong> mode for gaming. Use <strong>Comfort</strong> mode for daily tasks to keep fans quiet.</p>"
                },
                {
                    "id": "b3",
                    "type": "grid",
                    "columns": 2,
                    "children": [
                        {
                            "id": "pc1",
                            "type": "column",
                            "children": [
                                {
                                    "id": "t1",
                                    "type": "heading",
                                    "level": 3,
                                    "content": "Windows Power Plan"
                                },
                                {
                                    "id": "p1",
                                    "type": "text",
                                    "content": "<p>Set to <strong>High Performance</strong> in Control Panel. Disable 'USB selective suspend'.</p>"
                                }
                            ]
                        },
                        {
                            "id": "pc2",
                            "type": "column",
                            "children": [
                                {
                                    "id": "t2",
                                    "type": "heading",
                                    "level": 3,
                                    "content": "Background Apps"
                                },
                                {
                                    "id": "p2",
                                    "type": "text",
                                    "content": "<p>Disable startup apps in Task Manager. Turn off Windows Game Mode for some competitive titles if it causes input lag.</p>"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "gpu",
            "title": "Graphics Optimization",
            "content": "",
            "blocks": [
                {
                    "id": "gpu-intro",
                    "type": "text",
                    "content": "<p>Optimize your NVIDIA or AMD GPU settings for the best balance of performance and image quality. These settings are accessed through your GPU's control panel.</p>"
                },
                {
                    "id": "b4",
                    "type": "heading",
                    "level": 3,
                    "content": "NVIDIA Control Panel Settings"
                },
                {
                    "id": "gpu-nvidia-tip",
                    "type": "callout",
                    "variant": "info",
                    "title": "How to Access",
                    "content": "<p>Right-click desktop → NVIDIA Control Panel → Manage 3D Settings → Global Settings</p>"
                },
                {
                    "id": "b5",
                    "type": "list",
                    "content": {
                        "style": "unordered",
                        "items": [
                            "<strong>Power Management Mode:</strong> Prefer Maximum Performance",
                            "<strong>Texture Filtering Quality:</strong> High Performance",
                            "<strong>Vertical Sync:</strong> Off (use in-game settings or driver-level for specific games)",
                            "<strong>Max Frame Rate:</strong> Cap at your monitor's refresh rate (e.g., 144 FPS) to reduce heat and power",
                            "<strong>Low Latency Mode:</strong> On or Ultra for competitive games",
                            "<strong>Threaded Optimization:</strong> On"
                        ]
                    }
                },
                {
                    "id": "gpu-amd-h",
                    "type": "heading",
                    "level": 3,
                    "content": "AMD Radeon Settings"
                },
                {
                    "id": "gpu-amd-list",
                    "type": "list",
                    "content": {
                        "style": "unordered",
                        "items": [
                            "<strong>Radeon Anti-Lag:</strong> Enable for reduced input lag",
                            "<strong>Radeon Chill:</strong> Enable to save power when GPU isn't fully utilized",
                            "<strong>Texture Filtering Quality:</strong> Performance",
                            "<strong>Surface Format Optimization:</strong> On"
                        ]
                    }
                },
                {
                    "id": "gpu-warning",
                    "type": "callout",
                    "variant": "warning",
                    "title": "Game-Specific Overrides",
                    "content": "<p>Some games work better with specific settings. Use the 'Program Settings' tab to create per-game profiles if you encounter issues.</p>"
                }
            ]
        },
        {
            "id": "benchmarks",
            "title": "Benchmark Tools",
            "content": "",
            "blocks": [
                {
                    "id": "b6",
                    "type": "grid",
                    "columns": 2,
                    "children": [
                        {
                            "id": "bc1",
                            "type": "column",
                            "children": [
                                {
                                    "id": "bt1",
                                    "type": "callout",
                                    "variant": "success",
                                    "title": "3DMark",
                                    "content": "<p>Standard for testing GPU performance.</p>"
                                },
                                {
                                    "id": "bt2",
                                    "type": "callout",
                                    "variant": "info",
                                    "title": "Cinebench R23",
                                    "content": "<p>Best for testing CPU rendering speed and thermal stability.</p>"
                                }
                            ]
                        },
                        {
                            "id": "bc2",
                            "type": "column",
                            "children": [
                                {
                                    "id": "bt3",
                                    "type": "callout",
                                    "variant": "warning",
                                    "title": "MSI Afterburner",
                                    "content": "<p>Essential for monitoring temperatures and frametimes in-game.</p>"
                                },
                                {
                                    "id": "bt4",
                                    "type": "callout",
                                    "variant": "tip",
                                    "title": "UserBenchmark",
                                    "content": "<p>Quick check to see if components are performing below expectations.</p>"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}