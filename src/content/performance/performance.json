                                    "level": 3,
                                    "content": "Background Apps"
                                },
                                {
                                    "id": "p2",
                                    "type": "text",
                                    "content": "<p>Disable startup apps in Task Manager. Turn off Windows Game Mode for some competitive titles if it causes input lag.</p>"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
