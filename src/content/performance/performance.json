            "title": "Power & Thermal Management",
            "content": "",
            "blocks": [
                {
                    "id": "b1",
                    "type": "text",
                    "content": "<p>Optimize power consumption and thermal performance to prevent throttling.</p>"
                },
                {
                    "id": "b2",
                    "type": "callout",
                    "variant": "info",
                    "title": "OMEN Gaming Hub",
                    "content": "<p>Use <strong>Performance</strong> mode for gaming. Use <strong>Comfort</strong> mode for daily tasks to keep fans quiet.</p>"
                },
                {
                    "id": "b3",
                    "type": "grid",
                    "columns": 2,
                    "children": [
                        {
                            "id": "pc1",
                            "type": "column",
                            "children": [
                                {
                                    "id": "t1",
                                    "type": "heading",
                                    "level": 3,
                                    "content": "Windows Power Plan"
                                },
                                {
                                    "id": "p1",
                                    "type": "text",
                                    "content": "<p>Set to <strong>High Performance</strong> in Control Panel. Disable 'USB selective suspend'.</p>"
                                }
                            ]
                        },
                        {
                            "id": "pc2",
                            "type": "column",
                            "children": [
                                {
                                    "id": "t2",
