            "content": "",
            "blocks": [
                {
                    "id": "trouble-text",
                    "type": "text",
                    "content": "<p>Common issues when undervolting and how to fix them:</p>"
                },
                {
                    "id": "trouble-table",
                    "type": "table",
                    "content": {
                        "headers": ["Issue", "Solution"],
                        "rows": [
                            ["System crashes/BSOD", "Reduce undervolt by 10-20mV"],
                            ["Crashes only under load", "Your final undervolt is too aggressive - reduce by 5-10mV"],
                            ["Settings don't persist after restart", "Use ThrottleStop's startup guide or Task Scheduler"],
                            ["XTU returns VBS error (Windows 11)", "Disable Core Isolation in Windows Security settings"],
                            ["ThrottleStop values not applying (Windows 11)", "Disable Virtualization Based Security (see Known Issues)"]
                        ]
                    }
                },
                {
                    "id": "vbs-note",
                    "type": "callout",
                    "variant": "info",
                    "title": "Windows 11 VBS Issue",
                    "content": "<p>Windows 11 has Virtualization Based Security enabled by default. Search for <strong>Core Isolation</strong> in Start menu and turn it off. If you've used WSL2 or Hyper-V, remove those from Windows Features first.</p>"
                }
            ]
        }
